+        anchors.fill: parent
+        anchors.margins: 16
+        spacing: 12
+
+        Label {
+            text: qsTr("Live Signals")
+            font.pixelSize: 20
+            color: Theme.text
+        }
+
+        Label {
+            text: QtTune.connected
+                ? qsTr("Subscribed: %1 signals · batched @ 10 Hz").arg(QtTune.signalModel.subscribedCount)
